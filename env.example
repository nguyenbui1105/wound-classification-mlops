# =============================================================================
# Environment Configuration for Wound-AI Classification
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------

# Path to model checkpoint file (relative or absolute)
CHECKPOINT_PATH=artifacts/checkpoints/best_efficientnet.pt

# Model version (for tracking)
MODEL_VERSION=1.0.0

# -----------------------------------------------------------------------------
# API Server Configuration
# -----------------------------------------------------------------------------

# Host to bind the API server
API_HOST=0.0.0.0

# Port to run the API server
API_PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Maximum file upload size in bytes (10MB default)
MAX_UPLOAD_SIZE=10485760

# Enable/disable API documentation endpoints
ENABLE_DOCS=true

# -----------------------------------------------------------------------------
# Inference Configuration
# -----------------------------------------------------------------------------

# Default batch size for batch inference
DEFAULT_BATCH_SIZE=16

# Number of worker threads for image preprocessing
NUM_WORKERS=4

# Image size for model input
IMAGE_SIZE=224

# -----------------------------------------------------------------------------
# Artifacts & Storage
# -----------------------------------------------------------------------------

# Root directory for artifacts (checkpoints, metrics, outputs)
ARTIFACTS_DIR=artifacts

# Directory for temporary files
TEMP_DIR=artifacts/api_temp

# Directory for batch inference reports
REPORTS_DIR=artifacts/inference_reports

# -----------------------------------------------------------------------------
# Testing Configuration
# -----------------------------------------------------------------------------

# Set to 1 to enable testing mode (skips model loading, uses dummy predictor)
# Set to 0 for production mode
WOUND_API_TESTING=0

# -----------------------------------------------------------------------------
# Security (Production Only)
# -----------------------------------------------------------------------------

# Secret key for JWT tokens (generate with: openssl rand -hex 32)
# SECRET_KEY=your-secret-key-here

# Enable CORS (comma-separated origins)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Enable rate limiting
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=60

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------

# Enable Prometheus metrics endpoint
# ENABLE_METRICS=false

# Metrics endpoint path
# METRICS_PATH=/metrics

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# Log file path
LOG_FILE=api.log

# -----------------------------------------------------------------------------
# Database (Future Use)
# -----------------------------------------------------------------------------

# Database URL for storing predictions/metadata
# DATABASE_URL=sqlite:///./wound_ai.db

# Enable database logging
# DB_LOGGING=false

# -----------------------------------------------------------------------------
# External Services (Future Use)
# -----------------------------------------------------------------------------

# S3 bucket for storing images/models
# AWS_S3_BUCKET=wound-ai-models
# AWS_REGION=us-east-1

# Redis for caching
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Docker-Specific
# -----------------------------------------------------------------------------

# User ID for non-root container (default: 1000)
CONTAINER_UID=1000

# Group ID for non-root container (default: 1000)
CONTAINER_GID=1000

# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------

# Enable auto-reload for development
# AUTO_RELOAD=true

# Enable debug mode (shows detailed errors)
# DEBUG=false

# =============================================================================
# End of Configuration
# =============================================================================
